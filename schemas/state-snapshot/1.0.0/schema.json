        {
          "$ref": "https://github.com/CNTX-PROJECT/CNTX/schemas/common-artifact-envelope/1.0.0"
        },
        {
          "properties": {
            "artifactType": {
              "const": "state-snapshot"
            },
            "governingContract": {
              "properties": {
                "identifier": {
                  "const": "https://github.com/CNTX-PROJECT/CNTX/contract-definitions/state-snapshot"
                },
                "version": {
                  "const": "1.0.0"
                }
              }
            },
            "governingSchema": {
              "properties": {
                "identifier": {
                  "const": "https://github.com/CNTX-PROJECT/CNTX/schemas/state-snapshot/1.0.0"
                },
                "version": {
                  "const": "1.0.0"
                }
              }
            }
          }
        }
      ]
    },
    "payload": {
      "$ref": "#/$defs/stateSnapshotPayload"
    }
  },
  "required": [
    "envelope",
    "payload"
  ],
  "additionalProperties": false,
